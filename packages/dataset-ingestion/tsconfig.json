{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@tidal/types": ["../types/src/index.ts"] }
  },
  "references": [{ "path": "../types" }],
  "include": ["src/**/*.ts"]
}
